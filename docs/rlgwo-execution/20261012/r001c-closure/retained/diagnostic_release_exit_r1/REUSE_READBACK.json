        "excerpt": "// (LPOLL is bound from CONFIG.lp in bindConfig — &lp= still flows through the shared config parser.)\nconst DEBUGLAYERS = q.get(\"debugLayers\")===\"1\";   // &debugLayers=1 → live read-out of every sky/cloud layer opacity\nconst DEBUGMOON = q.get(\"debugMoon\")===\"1\";       // &debugMoon=1 → moon layer radii/opacities + a pixel-ring across the limb\nconst DEBUGDAWN = q.get(\"debugDawn\");             // DEPRECATED no-op: dawn is not a painted overlay anymore (true dawn = the physical twilight sky + Fajr marker; false dawn is not rendered). Kept only so old URLs don't error.\nconst DEBUGOPTIC = q.get(\"debugOptic\");           // &debugOptic=halo|sundogs|pillar|anticrep|paraselene|lunarhalo → force the corresponding QA branch; lunar forces retain moonlight eligibility\nconst QA = q.get(\"qa\")===\"1\";                     // &qa=1 → reset lastWxAt/lastWxTry on boot; window.qaState() is always assigned\nconst DEBUGMOTION = q.get(\"debugMotion\")===\"1\";   // &debugMotion=1 → live motion telemetry overlay (rAF & cloud-paint rates, reduced-motion, paused, cloud/star Δ over 10s/60s, wx source, timeScale, reason)\nconst MOTIONFULL = (q.get(\"motion\")||\"\")===\"full\";// &motion=full → force full animation even under OS prefers-reduced-motion. DEFAULT respects accessibility (motion reduced when the OS asks), but this gives an honest override for testing and for users who want it\n// SINGLE SOURCE for the reduced-motion decision (was duplicated as _REDUCED + _RM). Evaluated LIVE so a mid-session\n// OS toggle is honoured (matchMedia is cheap); &motion=full overrides. The CSS @media (prefers-reduced-motion) blocks\n// read the SAME native signal, gated by the .motionfull opt-out class — one decision, consulted by both JS and CSS.\nconst isMotionReduced = () => !MOTIONFULL && !!(window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches);\n"
