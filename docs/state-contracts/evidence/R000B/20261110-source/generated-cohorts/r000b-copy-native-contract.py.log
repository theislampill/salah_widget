from pathlib import Path
import hashlib,shutil
src=Path('/workspace/scratch/15b8fb6ac4c2/r000b-work/tests/native-script-contract.js')
dst=Path('/workspace/scratch/15b8fb6ac4c2/r000b-build-1/tests/native-script-contract.js')
assert hashlib.sha256(src.read_bytes()).hexdigest()=='033f877d7e521868a948e0b0d8019e550e15b97e4172a7ba97927141a11c45fd'
assert hashlib.sha256(dst.read_bytes()).hexdigest()=='adde2470bba5f276ddae71f0c5a2fad9485854604bbd733c87723583e04b578a'
shutil.copyfile(src,dst)
assert src.read_bytes()==dst.read_bytes()
print('copied exact frozen adapter to disposable build root')
