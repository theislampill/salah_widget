  "findings": [
    {
      "id": "R16-ENTRY-REVIEW-01",
      "classification": "PASS_SCOPED_HANDSHAKE",
      "finding": "The actual child writes its PID plus fresh nonce. The parent accepts only the launched PID and same nonce, takes the complete profile-at-ready snapshot while the child waits, then atomically publishes the matching acknowledgement. Original ready() was strengthened from any numeric PID to the exact launched PID. Missing/partial/foreign readiness cannot pass ordinary preview/product rows.",
      "sources": [
        "install-entry-coverage-support.py:221-267",
        "install-entry-native-coverage.py:91-118,312-313"
      ],
      "limits": "This is an owned-fixture protocol, not proof against arbitrary hostile same-user code. The intended bad-option row remains a parameter-binding failure before interception and still requires unchanged state/nonzero exit."
    },
    {
      "id": "R16-ENTRY-REVIEW-02",
      "classification": "PASS_SCOPED_PROFILE_ORACLE",
      "finding": "An independently identified host-only launch runs no installer, warms the same owned USERPROFILE, and retains before/ready/after inventories. Actual entry requires before==atReady and exact full before==after for preview. Snapshot fields include paths, file bytes/hash, native identity, mode, owner/group/DACL, attributes and recorded creation/modification times. There is no AppData, startup-cache or bundle-prefix exclusion.",
      "sources": [
        "install-entry-coverage-support.py:66-126",
        "install-entry-native-coverage.py:250-267,309-357"
      ],
      "limits": "These are snapshots plus existing effect spies, not an independent OS effect-denial boundary. Native startup quiescence is unacquired; startup/cache differences must fail the acquisition premise rather than be silently ignored or automatically assigned to the installer."
    },
    {
      "id": "R16-ENTRY-REVIEW-03",
      "classification": "PASS_SCOPED_NORMAL_BOUND",
      "finding": "Normal/NoOpen preserve all original behavior assertions. After those assertions validate the actual one retained bundle and manual handoffs, the comparator permits only the exact eight inventoried paths. Prior path/content/identity/security changes, another bundle, prior bundle reuse and extra/missing descendants are refused. Only the profile-root mtime difference associated with adding that direct child is normalized for normal mode; its raw value is retained.",
      "sources": [
        "install-entry-native-coverage.py:325-353",
        "install-entry-coverage-support.py:106-126"
      ],
      "limits": "The normal exception is explicit and absent from preview. This does not replace the R0015 archive/preset/native admission contract."
    },
    {
      "id": "R16-ENTRY-REVIEW-04",
      "classification": "PASS_SCOPED_UNREADABILITY_DESIGN; NATIVE_BLOCKED",
      "finding": "The unreadable case holds a Windows readable exclusive handle with share mode0 on the newly owned metadata. It observes bytes/security/identity through that handle and requires actual child file existence, IOException/native32 refusal, readable peer/hash, and exact child PID/nonce. The main caller must produce metadata-unreadable/unknown-held/no-eligible/no-effect failure. The unlocked counterpart must hash the same bytes and reach useful eligible preview. No discovery parser/eligibility implementation is copied into the fixture.",
      "sources": [
        "install-entry-coverage-support.py:129-218",
        "install-entry-native-coverage.py:79-94,268-281,314-324"
      ],
      "limits": "Windows share-mode refusal, actual main behavior and restoration have not been executed locally. The restoration finalizer removes pass credit on restore or receipt failure; independent Python checks exercise only that projection."
    },
    {
      "id": "R16-ENTRY-REVIEW-05",
      "classification": "PASS_SCOPED_ROUTE_RECEIVING",
      "finding": "The retained exact route fixture exercises actual Install-TablissNG, Select-TablissNgAsset and a positive Get-DiscoveryEligibility premise across Chromium/Firefox and explicit store, ask-store, ask-GitHub and ask-default. Controlled adapters declare artifact/transport/prompt/browser boundaries. Store excludes metadata/download/admission/copy/extract; GitHub preserves selected-object identity, URL, admitted paths, family extraction, handoff state and manager URL. Both ask prompt steps are checked.",
      "sources": [
        "install-powershell-routes.ps1:113-201",
        "isolated-route-controls.json"
      ],
      "limits": "Eight Linux PS7 caller rows and two causal mutants do not qualify Windows, native artifact admission, whole-entry unknown gating, or the original eighteen component rows. RoutesOnly intentionally selects added route rows; collector must retain original components and require fileErrors0 plus exact source/fixture bindings."
    },
    {
      "id": "R16-ENTRY-REVIEW-06",
      "classification": "GAP_NATIVE_ACQUISITION_PENDING",
      "finding": "The packet correctly preserves no native PASS. Complete selected Windows host/scenario results, held-file restoration receipts and actual profile-baseline quiescence are still required. The full14-scenario/two-host matrix contains28 entries with a separate baseline per entry; an8-entry pilot cannot satisfy it.",
      "sources": [
        "HANDOFF.md",
        "install-entry-native-coverage.py:371-411"
      ],
      "limits": "Retain per-child acquisition bounds and budget the collector for both baseline and product children. A timeout, snapshot/nonce failure, restoration failure or shorter failed-host run cannot be promoted to complete coverage. Full46-row R0016 denominator remains open."
    }
  ],
