+          const s=getComputedStyle(e);return {tag:e.tagName,className:e.className,id:e.id,rect:box(e),text:e.matches('.p b,.p .tm,#ce,#ah')?e.textContent:null,fontFamily:s.fontFamily,fontSize:s.fontSize,fontWeight:s.fontWeight,lineHeight:s.lineHeight,padding:s.padding,gap:s.gap,borderWidth:s.borderWidth,borderRadius:s.borderRadius};})};
+    }'''
