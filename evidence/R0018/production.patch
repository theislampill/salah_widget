+      const sheet=Array.from(document.styleSheets).find(s=>s.ownerNode?.tagName==='STYLE'&&Array.from(s.cssRules).some(r=>r.selectorText==='.p'));
+      if(!sheet)throw Error('Authored inline stylesheet missing');
+      const previous={};for(const [selector,text] of Object.entries(rules)){
