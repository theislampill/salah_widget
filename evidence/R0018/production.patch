+        if(matches.length!==1)throw Error('Ambiguous semantic CSS owner '+selector);
+        previous[selector]=matches[0].style.cssText;matches[0].style.cssText=text;
+      }return previous;
+    }'''
+    phases=[{'name':'candidate-initial','geometry':page.evaluate(capture)}]
+    page.screenshot(path=str(out/'geometry-candidate-initial.png'))
+    candidate=None
+    try:
+        for name,which in [('baseline-1','baseline'),('candidate-1','candidate'),('baseline-2','baseline'),('candidate-restored','candidate')]:
+            previous=page.evaluate(replace,rules if which=='baseline' else candidate)
