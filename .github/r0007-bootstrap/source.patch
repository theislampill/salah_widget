+        self.case = {"caseId": "healthy", "entry": "index.html", "expectedFailure": False,
+                     "orderedActions": [{"type": "capture", "name": "first-current", "firstRender": True,
+                                         "firstPredicate": "s.stage==='render-completed'", "selector": ".c"}]}
