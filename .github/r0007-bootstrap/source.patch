+    for value in [approval["headSha"], approval["baseSha"], approval["treeSha"], approval["baseTreeSha"], merge["mainSha"], merge["treeSha"], pages["sourceSha"]]:
+        if not re.fullmatch(r"[0-9a-f]{40}", value):
