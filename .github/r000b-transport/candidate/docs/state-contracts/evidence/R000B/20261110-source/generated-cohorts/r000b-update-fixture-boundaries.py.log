from pathlib import Path
import hashlib,json,sys
plans=json.loads('{"tests/r000b-sky-withdrawal.test.mjs": {"before": "de418202fcc8372ec92f1644a6eed0d50a6928347abb7da8189c2f5b0cbe57b8", "after": "7f37bb3158d7c886bd74feb61f219cb88881f6b75d2fed72f581d326a79f4037", "content": "import test from \'node:test\';\\nimport assert from \'node:assert/strict\';\\nimport fs from \'node:fs\';\\nimport vm from \'node:vm\';\\nimport {nativeJob,nativeResultCurrent} from \'../real-sky/native-contract.mjs\';\\nimport {NativeSolarMaskPublication} from \'../real-sky/native-composition.mjs\';\\n\\n// Execute both authored withdrawal owners. This checks the publication/class\\n// contract; it is not a browser-pixel substitute. B16 retains its original frames.\\nconst authored=name=>fs.readFileSync(new URL(\'../real-sky/\'+name,import.meta.url),\'utf8\');\\nfunction region(source,start,end){\\n  const a=source.indexOf(start),b=source.indexOf(end,a);\\n  assert.ok(a>=0&&b>a,\'authored withdrawal anchors\');return source.slice(a,b);\\n}\\nconst fullClear=region(authored(\'native-host.mjs\'),\' function clear(\',\' // Identity/age fences\');\\nconst previewClear=region(authored(\'native-preview-host.mjs\'),\' function clear(\',\' function prepareForeground\');\\nconst initial=()=>({utcMs:1788806700016,lat:24.47,lon:39.61,heightM:0,\\n  generation:0,sceneIdentity:\'24.47|39.61|Asia/Riyadh|wall\',\\n  camera:{azDeg:180,altDeg:45,fovYDeg:90,rollDeg:0},weather:null,\\n  lp:0,reducedMotion:false,units:\'c\',tz:\'Asia/Riyadh\',timeScale:1});\\nfunction fixture(current,{hasPreview=true,hasTerrain=true,detailOwner=\'refined-sky\'}={}){\\n  const classes=new Set([\'real-sky-composed\',\'real-sky-preview-ready\']);\\n  if(hasTerrain)classes.add(\'moon-ready\');\\n  let detailVisible=hasTerrain,cloudReconciliations=0;\\n  // Explicit cloud-port double: these cases qualify sky ownership, not weather\\n  // eligibility or pixels. Real cloud withdrawal has its separate source controls.\\n  const card={classList:{contains:x=>classes.has(x),add:x=>classes.add(x),remove:x=>classes.delete(x)},style:{removeProperty(){}}};\\n  const window={SalahNativeSkyHost:{reconcileClouds(){cloudReconciliations++;}},SalahMoonDetail:{clear(){detailVisible=false;},get state(){return {skyOwner:detailOwner,visible:detailVisible};}}};\\n  const job=nativeJob(initial());\\n  const preview={card,window,host:window.SalahNativeSkyHost,solarPublication:new NativeSolarMaskPublication(),pendingValue:{job},value:{job},previewFrame:hasPreview?{current:()=>nativeResultCurrent(job,current)}:null,\\n    status:{status:\'ready\'},retireFirstPaint(){},canvas:{style:{visibility:\'visible\'}}};\\n  vm.createContext(preview);vm.runInContext(previewClear,preview);\\n  window.SalahSkyPreview={get frame(){return preview.previewFrame;},get state(){return preview.status;},clear:reason=>preview.clear(reason)};\\n  const full={card,window,solarPublication:new NativeSolarMaskPublication(),pendingJob:{},frame:{},job:{},status:{},paintedFrame:{},paintedJob:{},previousPresentation:{},previousMoonBottom:100,\\n    ctx:{clearRect(){}},canvas:{style:{visibility:\'visible\'}},publish(){}};\\n  vm.createContext(full);vm.runInContext(fullClear,full);\\n  return {classes,preview,full,get detailVisible(){return detailVisible;},get cloudReconciliations(){return cloudReconciliations;},withdraw(){\\n    const before=cloudReconciliations;full.clear(\'accepted weather changed\');\\n    assert.ok(cloudReconciliations>before,\'refined withdrawal reconciles native clouds before exposing their canvas\');\\n    assert.equal(full.solarPublication.revision,1,\'withdrawal cancels the previous solar publication\');\\n    assert.equal(full.pendingJob,null,\'withdrawal drops the pending refined job\');\\n  }};\\n}\\n\\nfor(const [name,change,hasTerrain=true] of [\\n  [\'ordinary wet recovery\',s=>{s.weather={src:\'model-current\',temp:24,cloud:70,code:63};s.heightM=100;}],\\n  [\'preview age exceeds its unchanged30-second bound\',s=>{s.utcMs+=30001;}],\\n  [\'invalid accepted target\',s=>{s.lat=null;},false]\\n])test(\'refined withdrawal retires obsolete preview ownership: \'+name,()=>{\\n  const current=initial();change(current);const h=fixture(current,{hasTerrain});\\n  assert.equal(h.preview.previewFrame.current(),false,\'negative input reaches actual currentness predicate\');\\n  h.withdraw();\\n  assert.equal(h.classes.has(\'real-sky-composed\'),false);\\n  assert.equal(h.detailVisible,false,\'obsolete refined atmosphere cannot remain on the Moon\');\\n  assert.equal(h.classes.has(\'real-sky-preview-ready\'),false,\'invalid preview must not become the visible owner or hide the current SVG Moon\');\\n  assert.equal(h.preview.canvas.style.visibility,\'hidden\');\\n  assert.equal(h.classes.has(\'moon-ready\'),hasTerrain,\'sky withdrawal neither invents nor revokes independent terrain authority\');\\n});\\n\\ntest(\'withdrawal cannot expose a preview-ready flag without a corresponding frame\',()=>{\\n  const h=fixture(initial(),{hasPreview:false});h.withdraw();\\n  assert.equal(h.classes.has(\'real-sky-preview-ready\'),false);\\n});\\n\\nfor(const ageMs of [0,30000])test(`a current preview retains its own visible detail at age${ageMs} when refined sky withdraws`,()=>{\\n  const current=initial();current.utcMs+=ageMs;\\n  const h=fixture(current,{detailOwner:\'atmospheric-preview\'});assert.equal(h.preview.previewFrame.current(),true);h.withdraw();\\n  assert.equal(h.classes.has(\'real-sky-preview-ready\'),true);\\n  assert.equal(h.preview.canvas.style.visibility,\'visible\');\\n  assert.equal(h.detailVisible,true,\'another sky owner cannot erase a current preview-owned Moon\');\\n});\\n\\ntest(\'an expired preview-owned Moon is still withdrawn\',()=>{\\n  const current=initial();current.utcMs+=30001;const h=fixture(current,{detailOwner:\'atmospheric-preview\'});h.withdraw();\\n  assert.equal(h.classes.has(\'real-sky-preview-ready\'),false);assert.equal(h.detailVisible,false);\\n});\\n\\ntest(\'a current preview does not invent unavailable lunar terrain\',()=>{\\n  const h=fixture(initial(),{hasTerrain:false,detailOwner:\'atmospheric-preview\'});h.withdraw();\\n  assert.equal(h.classes.has(\'real-sky-preview-ready\'),true);assert.equal(h.classes.has(\'moon-ready\'),false);assert.equal(h.detailVisible,false);\\n});\\n\\ntest(\'explicit preview withdrawal still removes its own ready flag and detail\',()=>{\\n  const h=fixture(initial());h.preview.clear(\'native target invalidated\');\\n  assert.equal(h.cloudReconciliations,1,\'explicit preview withdrawal reconciles native clouds\');\\n  assert.equal(h.classes.has(\'real-sky-preview-ready\'),false);\\n  assert.equal(h.preview.canvas.style.visibility,\'hidden\');assert.equal(h.detailVisible,false);\\n  assert.equal(h.preview.solarPublication.revision,1);assert.equal(h.preview.pendingValue,null);\\n});\\n", "anchor": "Explicit cloud-port double"}, "tests/real-sky/native-head-handoff.cjs": {"before": "757be97483c5772afe92d08d93c3c94b7d81f6b264de53bb5242a9768b4608fc", "after": "4a167590ac6b0e447520f5ac329044c4b71913853d648f7769d9cab1112411cc", "content": "// Actual source lifecycle joined to the Moon host; no pixel or timing claim.\\n\'use strict\';\\nconst fs=require(\'node:fs\'),vm=require(\'node:vm\'),path=require(\'node:path\'),assert=require(\'node:assert/strict\');\\nconst repo=path.resolve(__dirname,\'../..\');\\nconst sourceFile=path.join(repo,\'src/native/index.html\');\\nconst hostFile=path.join(repo,\'moon/tests/host.test.cjs\');\\nconst html=fs.readFileSync(sourceFile,\'utf8\'),host=fs.readFileSync(hostFile,\'utf8\');\\nconst fixtureEnd=host.indexOf(\'\\\\ntest(\');\\nassert.ok(fixtureEnd>0,\'host fixture boundary\');\\nconst returnPrefix=\'return {w,workers,\';\\nconst fixture=host.slice(0,fixtureEnd);\\nassert.equal(fixture.split(returnPrefix).length,2,\'one fixture return boundary\');\\nconst rig=Function(\'require\',\'__dirname\',\\n fixture.replace(returnPrefix,\'return {context:c,w,workers,\')+\'\\\\nreturn rig;\'\\n)(require,path.join(repo,\'moon/tests\'));\\nfunction section(start,end){\\n const a=html.indexOf(start),b=html.indexOf(end,a+start.length);\\n assert.ok(a>=0&&b>a,\'actual source section \'+start);return html.slice(a,b);\\n}\\nconst lifecycle=section(\'let _skySceneKey=null\',\'// A current V5 receiver presentation\');\\nconst celestial=section(\'function paintCelestialWithoutTimetable(decision=weatherDecision()){\',\'function atmosphere(\');\\n// The scene invalidator now consumes the real cloud-publication owner. Bind its\\n// target and receipt dependencies from source instead of fabricating ready state.\\nconst cloudPublication=[\\n section(\'function wxNumber(\',\'\\\\nfunction wxValue(\'),\\n section(\'function captureWeatherTarget(\',\'\\\\nfunction loadWx(\'),\\n section(\'let _cloudFieldSeed=0;\',\'\\\\nconst _CLOUD_NOISE_PERIOD=\')\\n].join(\'\\\\n\');\\nconst boot=section(\'async function boot(){\',\'// SINGLE rAF render clock\');\\nfunction setup(){\\n const r=rig({initial:true,deferWorker:true}),c=r.context;r.head();\\n const card={classList:{add(){},remove(){}},style:{setProperty(){}}};\\n Object.assign(c,{\\n  _runtimeGeneration:0,_cfgMode:\'bare\',QA:false,lat:28.5,lon:-81.4,CONFIG:null,_needsDetect:false,\\n  $:()=>card,\\n  updateSkySurface(){},skySceneIdentity:()=>r.state.sceneIdentity,\\n  nowParts:()=>({h:2,mi:0,s:0}),moonGeometryObservation:()=>({fresh:true}),\\n  renderMoon(){},projectStars(){},simDate:()=>new Date(),\\n  lunarPresentation:()=>({moonShow:1,moonlight:1}),simulationReady:()=>true,\\n  // Optical sinks are outside this Moon handoff fixture; full inline-runtime\\n  // startup controls exercise their real shared owners separately.\\n  weatherDecision:()=>({record:null,renderCode:0}),wxDrivers:()=>({heat:0}),wxClass:()=>\\"clear\\",isMotionReduced:()=>false,\\n  nativeSolarPresentation:()=>({}),paintSolarPresentation(){},paintLunarOptic(){},\\n  buildSceneOnce(){},startWeather(){},enableSettingsAffordance(){},\\n  openSettings(){},startRenderLoop(){}\\n });\\n r.w.SalahNativeSkyHost={cloudLighting:()=>({sun:{altDeg:-20}})};\\n r.w.SalahStartSkyPreview=()=>{};\\n vm.runInContext(cloudPublication+\'\\\\n\'+lifecycle+\'\\\\n\'+celestial+\'\\\\n\'+boot,c);\\n c.render=()=>vm.runInContext(\'paintCelestialWithoutTimetable()\',c);\\n return r;\\n}\\nconst cases=[];\\n{\\n const r=setup();vm.runInContext(\'boot()\',r.context);\\n const value={renders:r.initialRenders,headHandoff:r.w.SalahMoonRuntime.state.firstInitial?.headHandoff,\\n  flag:vm.runInContext(\'_skyInitialDocument\',r.context),retained:r.w.SalahFirstPaint.moon.result!==null,epoch:r.w.SalahMoonRuntime.state.epoch};\\n cases.push({case:\'actual known boot before first yield\',value,passed:value.renders===1&&value.headHandoff===true&&!value.flag&&!value.retained&&value.epoch===2});\\n}\\n{\\n const r=setup();let acquisitions=0;r.context.lat=null;r.context._needsDetect=true;\\n const config={coarseDetect:()=>{acquisitions++;return new Promise(()=>{});}};\\n r.w.SalahConfig=config;r.context.SalahConfig=config;\\n vm.runInContext(\'boot()\',r.context);\\n const value={acquisitions,flag:vm.runInContext(\'_skyInitialDocument\',r.context),retained:r.w.SalahFirstPaint.moon.result!==null,renders:r.initialRenders};\\n cases.push({case:\'actual unresolved boot at acquisition await\',value,passed:value.acquisitions===1&&!value.flag&&!value.retained&&value.renders===1});\\n}\\n{\\n const r=setup();r.context.simulationReady=()=>false;vm.runInContext(\'boot()\',r.context);\\n const value={flag:vm.runInContext(\'_skyInitialDocument\',r.context),retained:r.w.SalahFirstPaint.moon.result!==null};\\n cases.push({case:\'actual invalid initial clock return\',value,passed:!value.flag&&!value.retained});\\n}\\n{\\n const r=setup();vm.runInContext(\'beginSkyScene();paintCelestialWithoutTimetable()\',r.context);\\n const value={renders:r.initialRenders,headHandoff:r.w.SalahMoonRuntime.state.firstInitial?.headHandoff,flag:vm.runInContext(\'_skyInitialDocument\',r.context)};\\n cases.push({case:\'actual default scene invalidation\',value,passed:value.renders===2&&value.headHandoff===false&&!value.flag});\\n}\\nfor(const condition of [\'paused\',\'invalid\']){\\n const r=rig({initial:true,deferWorker:true});r.head();\\n if(condition===\'paused\')r.state.paused=true;else r.state.utcMs=NaN;\\n r.w.SalahMoonRuntime.request();\\n if(condition===\'paused\')r.state.paused=false;else r.state.utcMs=1000;\\n r.w.SalahMoonRuntime.request();\\n const value={renders:r.initialRenders,headHandoff:r.w.SalahMoonRuntime.state.firstInitial?.headHandoff,retained:r.w.SalahFirstPaint.moon.result!==null};\\n cases.push({case:condition+\' return before first acceptance\',value,passed:value.renders===2&&value.headHandoff===false&&!value.retained});\\n}\\nconsole.log(JSON.stringify({allPassed:cases.every(x=>x.passed),cases},null,2));\\nif(cases.some(x=>!x.passed))process.exitCode=1;\\n", "anchor": "const cloudPublication=["}, "tests/r0003-harness.cjs": {"before": "2137a34c4f8685bdc26382837788d4815ea3c81321923c0eabd0994418892abd", "after": "c95cef02a0ce728e62106efc6f86dc7f88a48260e856c87ddd8522b869ab9ba6", "content": "\\"use strict\\";\\n// Source-bound fixture. Actual config, clock, admission/cache/transport, model, render,\\n// boot/apply, SKY boundary/projection bindings and the existing rAF loop run unchanged.\\n// Moon maps/builders/theme/canvas doubles contain unrelated art; no native/visual claim.\\nconst fs=require(\\"node:fs\\"),vm=require(\\"node:vm\\"),path=require(\\"node:path\\");\\nconst assert=require(\\"node:assert/strict\\"),crypto=require(\\"node:crypto\\");\\nconst {recordingDocument}=require(\\"./r0002-harness.cjs\\");\\nconst repo=path.resolve(__dirname,\\"..\\");\\nconst sourcePath=process.env.SALAH_REQUEST_SOURCE||path.join(repo,\\"index.html\\");\\nconst source=()=>fs.readFileSync(sourcePath,\\"utf8\\");\\nconst config=fs.readFileSync(process.env.SALAH_REQUEST_CONFIG||path.join(repo,\\"config.js\\"),\\"utf8\\");\\nconst ordinaryRaw=fs.readFileSync(path.join(repo,\\"tests/r0002-ordinary.json\\"),\\"utf8\\");\\nassert.equal(crypto.createHash(\\"sha256\\").update(ordinaryRaw).digest(\\"hex\\"),\\"40c6412a36a4644ec9db9a5c92ae2e682aa22dfd6bac45be249886cfe7e76282\\");\\nconst ordinary=JSON.parse(ordinaryRaw),copy=x=>JSON.parse(JSON.stringify(x));\\nfunction between(raw,a,b){const i=raw.indexOf(a),j=raw.indexOf(b,i+a.length);assert.ok(i>=0&&j>i,`source owner missing: ${a} / ${b}`);return raw.slice(i,j);}\\nfunction record(day=\\"07-09-2026\\",zone=\\"UTC\\",tag=\\"ordinary\\"){\\n  const r=copy(ordinary),[d,mo,y]=day.split(\\"-\\").map(Number);r.tag=tag;r.meta.timezone=zone;\\n  r.date.gregorian={...r.date.gregorian,date:day,day:String(d).padStart(2,\\"0\\"),month:{number:mo,en:\\"September\\"},year:String(y)};\\n  return r;\\n}\\nfunction deferred(){let resolve,reject;const promise=new Promise((a,b)=>{resolve=a;reject=b;});return {promise,resolve,reject};}\\nasync function settle(){for(let i=0;i<16;i++)await Promise.resolve();}\\nfunction harness(options={}){\\n  const raw=options.source||source();\\n  const slice=(a,b)=>between(raw,a,b);\\n  let elapsed=0,wall=Date.parse(options.epoch||\\"2026-09-07T12:00:00Z\\"),serial=0,context;\\n  const timers=new Map(),frames=new Map(),tasks=[],nodes=new Map(),storage=new Map(),reads=[],writes=[],requests=[],paints=[],errors=[],skyBuilders=[],cloudClears=[];\\n  class ClockDate extends Date {constructor(...a){super(...(a.length?a:[wall]));}static now(){return wall;}}\\n  function run(code){return vm.runInContext(code,context,{timeout:300});}\\n  function state(){return copy(run(\\"({today,tomorrow,tz,lat,lon,method,school,lastDate,fetchingTomorrow,_prayerStale,_loopStarted})\\"));}\\n  const {document,events}=recordingDocument(raw,{nodes,\\n    onText:(selector,text)=>{if(selector===\\".left\\")errors.push({text,at:elapsed});}\\n  });\\n  // Seed simple class selectors from their first authored body owner. ID aliases\\n  // share the recording node; later mutations retain their native attribute state.\\n  // This contains DOM effects, without emulating layout or live selector matching.\\n  const classOwners=new Map();\\n  for(const match of slice(\\"<body\\",\'<script\').matchAll(/<([a-z][\\\\w-]*)\\\\b([^>]*)>/gi)){\\n    const attrs=Object.fromEntries(Array.from(match[2].matchAll(/([\\\\w-]+)\\\\s*=\\\\s*\\"([^\\"]*)\\"/g),m=>[m[1],m[2]]));\\n    const owner={tag:match[1],attrs,node:null};\\n    for(const name of (attrs.class||\\"\\").split(/\\\\s+/).filter(Boolean))if(!classOwners.has(\\".\\"+name))classOwners.set(\\".\\"+name,owner);\\n  }\\n  const query=document.querySelector,classesRecorded=new WeakSet();\\n  document.querySelector=selector=>{\\n    const owner=classOwners.get(selector);\\n    if(owner&&!owner.node){\\n      owner.node=owner.attrs.id?query(\\"#\\"+owner.attrs.id):query(selector);\\n      if(owner.node&&!owner.attrs.id){owner.node.tagName=owner.tag.toUpperCase();for(const [key,value]of Object.entries(owner.attrs))owner.node.setAttribute(key,value);}\\n    }\\n    const n=owner?owner.node:query(selector);if(owner&&n)nodes.set(selector,n);\\n    if(!n||classesRecorded.has(n))return n;classesRecorded.add(n);\\n    // The existing style sink does not compute or render CSS. The exact lunar\\n    // withdrawal helper may read its empty style boundary without inventing pixels.\\n    n.style.getPropertyValue=()=>\\"\\";\\n    const read=()=>new Set((n.getAttribute(\\"class\\")||\\"\\").split(/\\\\s+/).filter(Boolean)),write=values=>n.setAttribute(\\"class\\",[...values].join(\\" \\"));\\n    n.classList={contains:value=>read().has(value),add:(...values)=>{const set=read();values.forEach(v=>set.add(v));write(set);},\\n      remove:(...values)=>{const set=read();values.forEach(v=>set.delete(v));write(set);},\\n      toggle:(value,force)=>{const set=read(),on=force===undefined?!set.has(value):!!force;if(on)set.add(value);else set.delete(value);write(set);return on;}};\\n    return n;\\n  };\\n  const sandbox={URLSearchParams,Intl,Date:ClockDate,AbortController,console:{warn(){},log(){}},performance:{now:()=>elapsed},\\n    location:{hash:options.hash||\\"#lat=10&lon=10&tz=UTC&method=2\\"},\\n    setTimeout:(fn,ms=0)=>{const id=++serial;timers.set(id,{at:elapsed+Number(ms),fn});return id;},clearTimeout:id=>timers.delete(id),\\n    requestAnimationFrame:fn=>{const id=++serial;frames.set(id,fn);return id;},cancelAnimationFrame:id=>frames.delete(id),\\n    MessageChannel:class{constructor(){this.port1={close(){}};this.port2={close(){},postMessage:()=>tasks.push(()=>this.port1.onmessage())};}},\\n    document,\\n    // Accepted calendar rendering skips unchanged text writes. Observe each valid\\n    // actual render at its existing lower theme consumer, after date projection.\\n    recordPrayerPaint:()=>paints.push({ce:nodes.get(\\"#ce\\").innerHTML,at:elapsed,...state()}),\\n    recordSkyBuilder:kind=>skyBuilders.push({kind,pending:document.querySelector(\\".c\\").classList.contains(\\"sky-pending\\"),...copy(run(\\"({sceneKey:_skySceneKey,projected:_starsProjected,generation:_runtimeGeneration,lat})\\"))}),\\n    recordCloudClear:(...args)=>cloudClears.push(args),\\n    localStorage:{getItem:k=>{reads.push(k);return storage.get(k)??null;},setItem:(key,value)=>{storage.set(key,value);writes.push({key,value,at:elapsed});}},\\n    fetch:(url,init={})=>{const headers=deferred(),body=deferred(),req={url,init,headers,body,at:elapsed};requests.push(req);\\n      req.ok=(data)=>{headers.resolve({ok:true,status:200,json:()=>body.promise});body.resolve({code:200,status:\\"OK\\",data:copy(data)});};\\n      req.fail=()=>headers.reject(new Error(\\"offline fixture\\"));\\n      if(options.offline)req.fail();return headers.promise;\\n    }\\n  };sandbox.window=sandbox;context=vm.createContext(sandbox);\\n  run(config);\\n  run(\'\\"use strict\\";\\\\n\'+slice(\'// ---- config:\',\\"// ---- weather (Open-Meteo:\\")+\\"\\\\n\\"+\\n    \\"let weather=null,weatherTrack=null,weatherRadar=null,lastWxAt=0,lastWxTry=0,lastRadarAt=0,wxBusy=false,radarBusy=false;\\\\n\\"+\\n    \\"const moonSky={_min:-1};\\\\n\\"+\\n    \\"function loadWx(){} function fetchWeather(){} function fetchRadar(){} function syncWeather(){}\\\\n\\"+\\n    // Header withdrawal is now independent of prayer readiness. These are\\n    // weather-boundary doubles, like fetchWeather above; actual header/effects\\n    // are exercised by hotfix-prayer-weather and the full-runtime browser tests.\\n    \\"function weatherDecision(){return {record:null,conditionState:\'unavailable\',target:currentWeatherTarget(),lane:null};} function weatherHeader(){return {};} function paintWeatherHeader(){}\\\\n\\"+\\n    \\"function buildStars(){recordSkyBuilder(\'stars\');} function buildWeather(){recordSkyBuilder(\'weather\');} function renderMoon(){} function fitCn(){} function applyTheme(){recordPrayerPaint();}\\\\n\\"+\\n    \\"function moonNow(){return {phase:0.5};} function phaseEmoji(){return \'moon\';} function moonGeometryObservation(){return {fresh:true};} function paintClouds(){} function tieRainToClouds(){} function updateSimClock(){}\\\\n\\"+\\n    \\"function enableSettingsAffordance(){} function openSettings(){}\\\\n\\"+\\n    // The unavailable weather double uses the real current target; exact source\\n    // cloud receipts below retain their own revision and invalidation state.\\n    slice(\\"function wxNumber(\\",\\"\\\\nfunction wxValue(\\")+\\"\\\\n\\"+\\n    slice(\\"function captureWeatherTarget(\\",\\"\\\\nfunction loadWx(\\")+\\"\\\\n\\"+\\n    // Exact production declarations/helpers: no copied ready flags or boundary substitutes.\\n    slice(\\"const _RAD=Math.PI/180,\\",\\"function _sunCoords(d){\\")+\\"\\\\n\\"+\\n    slice(\\"let _mAlb=null,\\",\\"(function loadMoonMaps(){\\")+\\"\\\\n\\"+\\n    slice(\\"let _starEls=[],\\",\\"function refreshStarAppearance(A){\\")+\\"\\\\n\\"+\\n    slice(\\"function skySceneIdentity(){\\",\\"function commitSkyScene(A){\\")+\\"\\\\n\\"+\\n    slice(\\"let _cloudFieldSeed=0;\\",\\"function advanceCloudMotion(civilSeconds){\\")+\\"\\\\n\\"+\\n    slice(\\"function lunarPresentation(\\",\\"function atmosphere(M){\\")+\\"\\\\n\\"+\\n    slice(\\"// ---- state ----\\",\\"// ---- continuous time-of-day sky\\")+\\"\\\\n\\"+\\n    slice(\\"function solarElevationDeg(M,a){\\",\\"function sunAltAt(M,a){\\")+\\"\\\\n\\"+\\n    slice(\\"let _lastBolt=-1, _lastRender=null;\\",\\"function updateSimClock(n){\\")+\\"\\\\n\\"+\\n    slice(\\"let _loopStarted=false;\\",\\"// \\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014\\u2014 in-widget settings\\"));\\n  async function advance(to){assert.ok(to>=elapsed);let budget=0;while(true){await settle();const next=[...timers].filter(([,t])=>t.at<=to).sort((a,b)=>a[1].at-b[1].at)[0];if(!next)break;if(++budget>200)throw Error(\\"fixture timer bound\\");const [id,t]=next;timers.delete(id);const at=Math.max(elapsed,t.at);wall+=at-elapsed;elapsed=at;t.fn();}wall+=to-elapsed;elapsed=to;await settle();}\\n  async function frame(){const pending=[...frames];frames.clear();for(const [,fn]of pending)fn(elapsed);await settle();}\\n  // Transport tests begin after the explicit two rendering opportunities and\\n  // posted task. Do not turn those callbacks into synchronous production work;\\n  // dedicated critical-path tests retain and assert the intermediate states.\\n  async function paintBoot(){await frame();await frame();while(tasks.length){tasks.shift()();await settle();}}\\n  async function startBoot(){const pending=run(\\"boot()\\");await paintBoot();return {pending};}\\n  return {run,state,storage,reads,writes,requests,paints,errors,nodes,document,timers,frames,advance,frame,settle,skyBuilders,cloudClears,\\n    wallBy:ms=>{wall+=ms;},elapse:ms=>{elapsed+=ms;wall+=ms;},elapsed:()=>elapsed,\\n    hide:()=>{sandbox.document.visibilityState=\\"hidden\\";events.get(\\"visibilitychange\\")?.();},\\n    show:()=