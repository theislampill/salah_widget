const fs=require('node:fs'),path=require('node:path'),{fileURLToPath}=require('node:url'),cp=require('node:child_process');const root=process.cwd(),base='eebba178172f96b3ffe5ab3845bc0fffd57c6e1b';const inputs=new Map(["src/native/index.html", "index.html", "real-sky/native-host.mjs", "real-sky/native-preview-host.mjs"].map(p=>[path.resolve(root,p),cp.execFileSync('git',['show',base+':'+p],{cwd:root,maxBuffer:32*1024*1024})]));const read=fs.readFileSync;fs.readFileSync=function(file,options){const p=path.resolve(file instanceof URL?fileURLToPath(file):String(file));if(inputs.has(p)){const buf=inputs.get(p),enc=typeof options==='string'?options:options?.encoding;return enc?buf.toString(enc):Buffer.from(buf);}return read.apply(this,arguments);};
