+def test_linked_worktree_applies_and_preserves_git_metadata(case,tmp_path):
+ r,p,m=case
+ w=tmp_path/'linked';git(r,'worktree','add','-b','moon-work',str(w))
+ before=(w/'.git').read_bytes()
+ result=load().install(w,p,mode='apply')
+ assert result['status']=='APPLIED'
+ assert (w/'src/input.txt').read_text()=='after\n'
+ assert (w/'.git').read_bytes()==before
+ assert git(w,'rev-parse','HEAD')==m['pin']
+ assert (r/'src/input.txt').read_text()=='before\n'
+
