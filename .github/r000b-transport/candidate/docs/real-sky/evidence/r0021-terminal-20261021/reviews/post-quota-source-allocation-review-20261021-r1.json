  "findings": [
    {
      "id": "A1",
      "source": "native-host.mjs:100-114",
      "finding": "compose allocates failed before currentness checks and pending/unchanged returns. Use an owner-scoped compositionFailed(error,acceptedFrame,acceptedJob); synchronous catch must call it even before a publication context exists."
    },
    {
      "id": "A2",
      "source": "native-composition.mjs:38-62",
      "finding": "publish allocates finish before displayed/decoded/clear fast paths. A prototype finish helper and stable caller handlers with optional exact context remove this added churn. New positive-mask decode promise handlers remain only at the real asynchronous boundary."
    },
    {
      "id": "A3",
      "source": "native-preview-host.mjs:51-96; native-host.mjs:147-170",
      "finding": "preview per-paint retry/failed/commit and refined commit callbacks also recur for cached/clear masks. They are not justified merely by calling publish. Use owner-stable helpers and each existing fresh capture/prepare record as immutable publication context; destructure local references before reentrant work."
    },
    {
      "id": "A4",
      "source": "native-host.mjs:38",
      "finding": "encodeNativeDisplayInto local code callback is added relative to 18ff encoder, runs per encode and is unrelated to changed-mask lifecycle. Hoist its exact search to a module/table-owned helper without changing arithmetic, inputs or per-call preceding-channel state."
    }
  ],
  "alreadyExisting": "Exact 18ff comparison shows the presentation comparison record, calendarGeometry records/mask closures, foreground capture/prepare records, previewFrame.current closure and update retry closure predate these changes. No new allocation defect is inferred merely from their presence. Existing records must not be expanded into persistent buffer roots.",
  "preservationConditions": [
    "Keep synchronous clear/cached-mask commit, commit=false and thrown-commit error behavior. Preserve decoded-resource assignment before commit and revision checks before and after callbacks.",
    "Do not store context in displayed/decoded resource records or previousPresentation. Resource records hold mask/image only. Async closure holds its own per-publication context until settlement, never a mutable shared global context.",
    "Preserve paused/currentness/age/catalogue-revision guards, final original-job recheck, one bounded retry, fallible lunar-detail-before-visible-background order and predecessor retention.",
    "Clear-gradient candidate may be one shared immutable module record; genuine positive-mask candidates are bounded by current publication lifecycle. No whole-heap/GC claim follows from the field bound."
  ],
  "minimumControls": [
    "Existing actual NativeSolarMaskPublication joined preview/refined/lifecycle tests remain applicable; rerun only affected controls by ROOT. Existing exact encoder oracle controls cover helper extraction.",
    "Concrete new risk: one stable handler receives original context through async decode, cached synchronous reuse, thrown commit and cancelled late response.",
    "Concrete reentrancy risk: commit A cancels/retries B synchronously, then A returns/throws; A cannot replace B displayed/pending identity, and A error keeps A context.",
    "A pending or unchanged refined tick must not create the added handlers; repeated cached/clear publication uses the same caller callback identities. Check source-defined locations and context roots, not only a function-call count."
  ],
